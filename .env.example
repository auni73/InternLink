# ──────────────────────────────────────────────────────────────────────────────
# InternLink — Environment Variables (.env)
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# This file is for containerized / deployed environments where dotnet
# user-secrets cannot exist. For local Visual Studio / CLI development,
# continue using `dotnet user-secrets`; environment variables override it when
# both are configured (ASP.NET Core's default configuration layering order).
#
# IMPORTANT: Do NOT commit `.env` to Git — it is listed in `.gitignore`.
# ──────────────────────────────────────────────────────────────────────────────

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# For Production behind a reverse proxy, add the proxy's stable IP address, e.g.:
# ForwardedHeaders__KnownProxies__0=172.20.0.10

# ── Database ──────────────────────────────────────────────────────────────────
# WARNING: The connection strings in appsettings.json / appsettings.Development.json
# use Windows Trusted/Integrated auth (Trusted_Connection=True).  That authentication
# mode has NO equivalent across separate Linux containers or remote deployments.
# The value here MUST use SQL Authentication (User Id / Password) instead.
# Do NOT copy the Trusted_Connection string from appsettings — it will fail.
# Use the same SQL Server administrator password here and for SA_PASSWORD below.
ConnectionStrings__InternLinkDb=Server=sqlserver;Database=InternLink;User Id=sa;Password=<YOUR_SA_PASSWORD>;TrustServerCertificate=True
SA_PASSWORD=<YOUR_SA_PASSWORD>

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Comma-separated rotation pool — get 2–3 keys from Google AI Studio.
Gemini__ApiKeys=<YOUR_GEMINI_KEY_1>,<YOUR_GEMINI_KEY_2>
Gemini__Model=gemini-3.6-flash
Gemini__EmbeddingModel=gemini-embedding-2

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
# Qdrant Cloud cluster URL (no port) and API key.
# Self-hosted Qdrant is NOT supported by the current code — the gRPC client
# hardcodes https and requires a non-empty API key (see QdrantJobVectorStore.cs).
Qdrant__Endpoint=https://<YOUR_CLUSTER>.cloud.qdrant.io
Qdrant__ApiKey=<YOUR_QDRANT_API_KEY>
Qdrant__CollectionName=internlink-jobs

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
# In Development mode, OTP codes are logged to console regardless of SMTP config.
# These are required for Production email delivery via MailKit.
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=<YOUR_SMTP_USER>
Smtp__Pass=<YOUR_SMTP_PASSWORD>
Smtp__FromAddress=no-reply@internlink.example

# ── File Storage ──────────────────────────────────────────────────────────────
# Absolute path where generated resume PDFs are stored.
# DiskFileStorage already handles arbitrary paths via Path.Combine — no code
# change needed; a Linux path works out of the box.
Storage__ResumeRoot=/app/data/resumes
