@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1><i class="bi bi-lock"></i>Welcome back</h1>
    <p class="auth-subtitle">Enter your credentials to access your account.</p>

    @if (TempData["OtpInfo"] is string info)
    {
        <div class="alert alert-info">@info</div>
    }

    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="auth-field mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <div class="auth-input-wrap">
                <i class="bi bi-envelope bi-lead"></i>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="auth-field mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="auth-input-wrap">
                <i class="bi bi-lock bi-lead"></i>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <button type="button" class="toggle-password" data-target="Password" tabindex="-1" aria-label="Show password">
                    <i class="bi bi-eye bi-dense"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="form-check mb-3 d-none">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary btn-auth w-100">Sign In</button>
    </form>

    <!-- 1-Click Quick Demo Login Section -->
    <div class="mt-4 pt-3 border-top">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="small fw-bold text-slate-700 text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Quick Test Logins
            </span>
            <span class="badge bg-light text-muted border" style="font-size: 0.65rem;">1-Click Demo</span>
        </div>
        <div class="row g-2">
            <div class="col-6">
                <button type="button" class="btn btn-outline-primary btn-sm w-100 d-flex align-items-center justify-content-center gap-2 py-2 quick-login-btn"
                        data-email="student@internlink.test" data-password="Student123!" title="Student (Tanvir Ahmed, CSE)">
                    <i class="bi bi-mortarboard-fill text-primary"></i>
                    <span class="fw-semibold small">Student</span>
                </button>
            </div>
            <div class="col-6">
                <button type="button" class="btn btn-outline-success btn-sm w-100 d-flex align-items-center justify-content-center gap-2 py-2 quick-login-btn"
                        data-email="techcorp@internlink.test" data-password="Company123!" title="Company (TechCorp Innovations)">
                    <i class="bi bi-building-fill text-success"></i>
                    <span class="fw-semibold small">Company</span>
                </button>
            </div>
            <div class="col-6">
                <button type="button" class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center gap-2 py-2 quick-login-btn"
                        data-email="admin@internlink.test" data-password="Admin123!" title="System Admin">
                    <i class="bi bi-shield-lock-fill text-danger"></i>
                    <span class="fw-semibold small">Admin</span>
                </button>
            </div>
            <div class="col-6">
                <button type="button" class="btn btn-outline-info btn-sm w-100 d-flex align-items-center justify-content-center gap-2 py-2 quick-login-btn"
                        data-email="counselor@internlink.test" data-password="Counselor123!" title="Career Counselor">
                    <i class="bi bi-person-badge-fill text-info"></i>
                    <span class="fw-semibold small">Counselor</span>
                </button>
            </div>
        </div>
    </div>

    <hr class="my-4" />
    <p class="text-center mb-0 text-muted">
        Don't have an account? <a asp-action="Register" class="fw-semibold text-decoration-none">Sign up</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.quick-login-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const email = btn.getAttribute('data-email');
                    const password = btn.getAttribute('data-password');
                    const emailInput = document.querySelector('input[name="Email"]');
                    const passwordInput = document.querySelector('input[name="Password"]');
                    const form = emailInput?.closest('form');

                    if (emailInput && passwordInput && form) {
                        emailInput.value = email;
                        passwordInput.value = password;
                        btn.disabled = true;
                        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
                        form.submit();
                    }
                });
            });
        });
    </script>
}
