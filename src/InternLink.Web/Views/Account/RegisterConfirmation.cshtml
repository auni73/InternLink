@{
    ViewData["Title"] = "Check your email";
}

<div class="text-center py-5">
    <h1 class="h3">Almost there</h1>
    <p class="text-muted">
        We've sent a confirmation link to your email address. Please confirm your account before signing in.
    </p>
    <p class="text-muted small">
        In Development, the confirmation link is written to the application console instead of being emailed.
    </p>
    <a asp-action="Login" class="btn btn-primary">Go to sign in</a>
</div>
