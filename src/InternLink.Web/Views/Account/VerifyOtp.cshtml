@model VerifyOtpViewModel
@{
    ViewData["Title"] = "Verify code";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1><i class="bi bi-shield-lock"></i>Enter your code</h1>
    <p class="auth-subtitle">We emailed you a 6-digit verification code. It expires in 5 minutes.</p>

        @if (TempData["OtpInfo"] is string info)
        {
            <div class="alert alert-info">@info</div>
        }

        <form asp-action="VerifyOtp" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control form-control-lg text-center" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="6" pattern="\d{6}" autofocus />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Verify</button>
        </form>

        <form asp-action="ResendOtp" method="post" class="mt-3">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" id="resendBtn" class="btn btn-link p-0">Resend code</button>
            <span id="resendTimer" class="text-muted small"></span>
        </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Server also enforces a 30s cooldown; this is just UX.
            var btn = document.getElementById('resendBtn');
            var timer = document.getElementById('resendTimer');
            var remaining = 30;

            function tick() {
                if (remaining <= 0) {
                    btn.disabled = false;
                    timer.textContent = '';
                    return;
                }
                btn.disabled = true;
                timer.textContent = ' (available in ' + remaining + 's)';
                remaining -= 1;
                setTimeout(tick, 1000);
            }
            tick();
        })();
    </script>
}
