@model RegisterViewModel
@{
    ViewData["Title"] = "Create an account";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h1><i class="bi bi-person"></i>Create an account</h1>
    <p class="auth-subtitle">Join InternLink to connect with opportunities.</p>

    <form asp-action="Register" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="auth-field mb-3">
            <label class="form-label">I am a...</label>
            <div class="role-segment">
                <input type="radio" class="btn-check" asp-for="Role" value="Student" id="roleStudent" autocomplete="off">
                <label for="roleStudent"><i class="bi bi-mortarboard"></i>Student</label>

                <input type="radio" class="btn-check" asp-for="Role" value="Company" id="roleCompany" autocomplete="off">
                <label for="roleCompany"><i class="bi bi-building"></i>Company</label>
            </div>
            <span asp-validation-for="Role" class="text-danger small"></span>
        </div>

        <div id="studentFields">
            <div class="row">
                <div class="col-6 auth-field mb-3">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-person bi-lead"></i>
                        <input asp-for="FirstName" class="form-control" placeholder="John" />
                    </div>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col-6 auth-field mb-3">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <div class="auth-input-wrap">
                        <input asp-for="LastName" class="form-control" placeholder="Doe" />
                    </div>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-6 auth-field mb-3">
                    <label asp-for="InstitutionalId" class="form-label">Student ID</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-person-badge bi-lead"></i>
                        <input asp-for="InstitutionalId" class="form-control" placeholder="2020-1-60-001" />
                    </div>
                    <span asp-validation-for="InstitutionalId" class="text-danger small"></span>
                </div>
                <div class="col-6 auth-field mb-3">
                    <label asp-for="CGPA" class="form-label">CGPA</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-award bi-lead"></i>
                        <input asp-for="CGPA" class="form-control" type="number" step="0.01" min="0" max="4" placeholder="3.50" />
                    </div>
                    <span asp-validation-for="CGPA" class="text-danger small"></span>
                </div>
            </div>
            <div class="auth-field mb-3">
                <label asp-for="Department" class="form-label">Department</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-mortarboard bi-lead"></i>
                    <input asp-for="Department" class="form-control" placeholder="Computer Science & Engineering" />
                </div>
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>
        </div>

        <div id="companyFields">
            <div class="auth-field mb-3">
                <label asp-for="CompanyName" class="form-label">Company Name</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-building bi-lead"></i>
                    <input asp-for="CompanyName" class="form-control" placeholder="Acme Ltd." />
                </div>
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>
            <div class="auth-field mb-3">
                <label asp-for="IndustrySector" class="form-label">Industry Sector</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-diagram-3 bi-lead"></i>
                    <input asp-for="IndustrySector" class="form-control" placeholder="Software Development" />
                </div>
                <span asp-validation-for="IndustrySector" class="text-danger small"></span>
            </div>
            <div class="auth-field mb-3">
                <label asp-for="CorporateWebsite" class="form-label">Website <span class="text-muted fw-normal">(optional)</span></label>
                <div class="auth-input-wrap">
                    <i class="bi bi-globe bi-lead"></i>
                    <input asp-for="CorporateWebsite" class="form-control" placeholder="https://example.com" />
                </div>
                <span asp-validation-for="CorporateWebsite" class="text-danger small"></span>
            </div>
        </div>

        <div class="auth-field mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <div class="auth-input-wrap">
                <i class="bi bi-envelope bi-lead"></i>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="auth-field mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="auth-input-wrap">
                <i class="bi bi-lock bi-lead"></i>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                <button type="button" class="toggle-password" data-target="Password" tabindex="-1" aria-label="Show password">
                    <i class="bi bi-eye bi-dense"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="auth-field mb-4">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <div class="auth-input-wrap">
                <i class="bi bi-lock bi-lead"></i>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                <button type="button" class="toggle-password" data-target="ConfirmPassword" tabindex="-1" aria-label="Show password">
                    <i class="bi bi-eye bi-dense"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-auth w-100">Create Account</button>
    </form>

    <hr class="my-4" />
    <p class="text-center mb-0 text-muted">
        Already have an account? <a asp-action="Login" class="fw-semibold text-decoration-none">Sign in</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var studentFields = document.getElementById('studentFields');
            var companyFields = document.getElementById('companyFields');
            var studentRadio = document.getElementById('roleStudent');
            var companyRadio = document.getElementById('roleCompany');

            function toggleFields() {
                var isStudent = studentRadio.checked;
                studentFields.style.display = isStudent ? '' : 'none';
                companyFields.style.display = isStudent ? 'none' : '';
            }

            studentRadio.addEventListener('change', toggleFields);
            companyRadio.addEventListener('change', toggleFields);
            toggleFields();
        })();
    </script>
}
