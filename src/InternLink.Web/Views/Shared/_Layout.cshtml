@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirstValue(ClaimTypes.Role);
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var showSidebar = isAuthenticated && !string.IsNullOrEmpty(area);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@requestToken" />
    <title>@ViewData["Title"] - InternLink</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InternLink.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="app-topbar navbar navbar-expand px-3">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-mortarboard-fill"></i>
                <span>InternLink</span>
            </a>

            <div class="ms-auto d-flex align-items-center gap-3">
                @if (isAuthenticated)
                {
                    if (!string.IsNullOrEmpty(role))
                    {
                        <span class="role-badge" title="Signed-in role">@role</span>
                    }

                    <button type="button" class="btn btn-link text-body position-relative p-1" title="Notifications" aria-label="Notifications">
                        <i class="bi bi-bell"></i>
                    </button>

                    <div class="dropdown">
                        <button class="btn btn-link text-body dropdown-toggle d-flex align-items-center gap-2 text-decoration-none"
                                type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-sm-inline">@User.Identity!.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text small text-muted">@User.Identity!.Name</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right bi-dense me-2"></i>Sign out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="nav-link text-body" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Get Started <i class="bi bi-arrow-right bi-dense"></i></a>
                }
            </div>
        </nav>
    </header>

    @if (showSidebar)
    {
        <div class="app-shell">
            <aside class="app-sidebar">
                <partial name="_Sidebar" />
            </aside>
            <main role="main" class="app-main">
                <partial name="_Toasts" />
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main role="main" class="container app-main-plain">
            <partial name="_Toasts" />
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/toasts.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
