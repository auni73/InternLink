@model InternLink.Web.ViewModels.SkillGapResult
@{
    var forCompany = Model.Perspective == InternLink.Web.ViewModels.SkillGapPerspective.Company;
    var haveHeading = forCompany ? "Candidate Has" : "You Have";
    var gapHeading = forCompany ? "Candidate's Gap" : "Your Gap";
    var subject = forCompany ? "This candidate" : "You";
}

<div class="skill-gap-panel">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h6 class="fw-bold text-slate-800 mb-1">Skill Gap Analysis</h6>
            <div class="small text-secondary">
                @subject match@(forCompany ? "es" : "") @Model.Matched.Count of @Model.Needed.Count required skills for @Model.JobTitle.
            </div>
        </div>
        <div class="text-end">
            <div class="fs-4 fw-bold @(Model.MatchPercentage >= 60 ? "text-success" : "text-warning-emphasis")">
                @Model.MatchPercentage.ToString("0")%
            </div>
            @if (Model.MustHaveGapCount > 0)
            {
                <div class="small text-danger-emphasis">
                    @Model.MustHaveGapCount must-have@(Model.MustHaveGapCount == 1 ? "" : "s") missing
                </div>
            }
        </div>
    </div>

    @if (!Model.SuggestionsAvailable)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2 py-2 px-3" role="alert">
            <i class="bi bi-exclamation-triangle mt-1"></i>
            <div class="small mb-0">
                Learning suggestions are unavailable right now. The skill comparison below is unaffected &mdash;
                it is computed directly from the recorded skills, not by the AI.
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card border-0 bg-light-subtle h-100">
                <div class="card-body p-3">
                    <div class="fw-semibold text-slate-800 mb-2">
                        <i class="bi bi-check2-circle text-success me-1"></i>@haveHeading
                        <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@Model.Have.Count</span>
                    </div>
                    @if (Model.Have.Count == 0)
                    {
                        <p class="small text-secondary mb-0">No skills recorded yet.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                            @foreach (var skill in Model.Have)
                            {
                                <li class="d-flex align-items-center gap-2">
                                    <i class="bi bi-check-lg text-success"></i>
                                    <span class="small">@skill.SkillName</span>
                                    @if (skill.IsVerified)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill"
                                              title="Passed a skill assessment">
                                            <i class="bi bi-patch-check-fill"></i> Verified
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 bg-light-subtle h-100">
                <div class="card-body p-3">
                    <div class="fw-semibold text-slate-800 mb-2">
                        <i class="bi bi-bullseye text-primary me-1"></i>This Role Needs
                        <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@Model.Needed.Count</span>
                    </div>
                    @if (Model.Needed.Count == 0)
                    {
                        <p class="small text-secondary mb-0">This posting lists no required skills.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                            @foreach (var skill in Model.Needed)
                            {
                                var isMatched = Model.Matched.Any(m => m.SkillId == skill.SkillId);
                                <li class="d-flex align-items-center justify-content-between gap-2">
                                    <span class="d-flex align-items-center gap-2">
                                        <i class="bi @(isMatched ? "bi-check-lg text-success" : "bi-dash-lg text-secondary")"></i>
                                        <span class="small @(skill.IsMustHave ? "fw-semibold text-slate-800" : "")">@skill.SkillName</span>
                                        @if (skill.IsMustHave)
                                        {
                                            <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill">Must-have</span>
                                        }
                                    </span>
                                    <span class="small text-secondary" title="Importance weight @skill.Weight of 5">@skill.Weight/5</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 bg-light-subtle h-100">
                <div class="card-body p-3">
                    <div class="fw-semibold text-slate-800 mb-2">
                        <i class="bi bi-graph-up-arrow text-warning me-1"></i>@gapHeading
                        <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">@Model.Gap.Count</span>
                    </div>
                    @if (Model.Gap.Count == 0)
                    {
                        <p class="small text-success-emphasis mb-0">
                            <i class="bi bi-trophy me-1"></i>Every required skill is covered.
                        </p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var skill in Model.Gap)
                            {
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="small fw-semibold text-slate-800">@skill.SkillName</span>
                                        @if (skill.IsMustHave)
                                        {
                                            <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill">Must-have</span>
                                        }
                                    </div>
                                    @if (skill.LearningResources.Count > 0)
                                    {
                                        <ul class="small text-secondary mb-0 ps-3">
                                            @foreach (var resource in skill.LearningResources)
                                            {
                                                <li>@resource</li>
                                            }
                                        </ul>
                                    }
                                    else if (Model.SuggestionsAvailable)
                                    {
                                        <div class="small text-secondary">No specific pointers returned for this skill.</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
