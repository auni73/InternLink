@model PaginationViewModel
@{
    if (Model.TotalPages <= 1)
    {
        return;
    }

    string PageLink(int page) => $"?page={page}&pageSize={Model.PageSize}";
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}

<nav aria-label="Pagination">
    <ul class="pagination">
        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link" href="@PageLink(Model.Page - 1)" tabindex="@(Model.HasPrevious ? "0" : "-1")">
                <i class="bi bi-chevron-left bi-dense"></i>
            </a>
        </li>

        @for (var p = start; p <= end; p++)
        {
            <li class="page-item @(p == Model.Page ? "active" : "")">
                <a class="page-link" href="@PageLink(p)">@p</a>
            </li>
        }

        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link" href="@PageLink(Model.Page + 1)" tabindex="@(Model.HasNext ? "0" : "-1")">
                <i class="bi bi-chevron-right bi-dense"></i>
            </a>
        </li>
    </ul>
</nav>
