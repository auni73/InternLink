@model InternLink.Web.ViewModels.StudentProfileViewModel
@{
    ViewData["Title"] = "Student Profile";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-slate-800 mb-1">Student Profile</h2>
            <p class="text-muted mb-0">Manage your academic credentials and career preferences.</p>
        </div>
        <div>
            <a asp-area="Student" asp-controller="Resumes" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-person me-2"></i>My Resumes
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-semibold">Personal & Academic Details</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-area="Student" asp-controller="Profile" asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="StudentId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-medium">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" placeholder="e.g. Jane" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-medium">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="LastName" class="form-control" placeholder="e.g. Doe" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="InstitutionalId" class="form-label fw-medium">Institutional Student ID</label>
                                <input asp-for="InstitutionalId" class="form-control bg-light" readonly />
                                <div class="form-text small">Assigned during registration. Contact administration for updates.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Department" class="form-label fw-medium">Department <span class="text-danger">*</span></label>
                                <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science & Engineering" />
                                <span asp-validation-for="Department" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CGPA" class="form-label fw-medium">Current CGPA (0.00 – 4.00) <span class="text-danger">*</span></label>
                                <input asp-for="CGPA" type="number" step="0.01" min="0.00" max="4.00" class="form-control" />
                                <span asp-validation-for="CGPA" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Interests" class="form-label fw-medium">Career Interests & Domains</label>
                                <input asp-for="Interests" class="form-control" placeholder="e.g. Cloud Architecture, Machine Learning, Full-Stack" />
                                <span asp-validation-for="Interests" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Biography" class="form-label fw-medium">Professional Biography</label>
                                <textarea asp-for="Biography" rows="4" class="form-control" placeholder="Brief summary of your academic background, passions, and career aspirations..."></textarea>
                                <span asp-validation-for="Biography" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-2"></i>Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 fw-semibold">Verified & Profile Skills</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.CurrentSkills != null && Model.CurrentSkills.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in Model.CurrentSkills)
                            {
                                var isVerified = Model.VerifiedSkillIds != null && Model.VerifiedSkillIds.Contains(skill.SkillId);
                                <div class="badge @(isVerified ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-dark border") p-2 d-flex align-items-center gap-2">
                                    @if (isVerified)
                                    {
                                        <i class="bi bi-patch-check-fill text-success" title="Verified Skill"></i>
                                    }
                                    <span class="fw-semibold">@(skill.Skill?.SkillName ?? "Skill")</span>
                                    <span class="badge @(isVerified ? "bg-success" : "bg-primary") rounded-pill">Level @skill.ProficiencyLevel/5</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-patch-question display-6 text-slate-300"></i>
                            <p class="mt-2 mb-0 small">No skills added yet. Build your resume or complete skill assessments to showcase competencies.</p>
                        </div>
                    }

                    <div class="mt-4 pt-3 border-top d-flex flex-column gap-2">
                        <a asp-area="Student" asp-controller="Assessments" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">
                            <i class="bi bi-patch-check me-1"></i>Take Skill Assessments
                        </a>
                        <a asp-area="Student" asp-controller="Resumes" asp-action="Builder" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="bi bi-plus-circle me-1"></i>Edit Skills in Resume Builder
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
