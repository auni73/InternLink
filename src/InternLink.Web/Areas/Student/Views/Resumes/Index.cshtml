@model InternLink.Web.ViewModels.ResumeListViewModel
@{
    ViewData["Title"] = "My Resumes";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-slate-800 mb-1">My Resumes</h2>
            <p class="text-muted mb-0">Build, customize, and export professional PDF resumes.</p>
        </div>
        <div>
            <a asp-area="Student" asp-controller="Resumes" asp-action="Builder" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Create New Resume
            </a>
        </div>
    </div>

    @if (Model.Resumes != null && Model.Resumes.Count > 0)
    {
        <div class="row g-4">
            @foreach (var resume in Model.Resumes)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border rounded-3 transition-hover">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title fw-bold text-slate-800 mb-1">@resume.FullName</h5>
                                    <span class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>Updated @resume.LastModified.ToString("MMM dd, yyyy HH:mm")
                                    </span>
                                </div>
                                @if (resume.IsFinalized)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>Finalized
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                        <i class="bi bi-pencil-fill me-1"></i>Draft
                                    </span>
                                }
                            </div>

                            <div class="mb-4">
                                <div class="d-flex gap-3 text-muted small">
                                    <span><i class="bi bi-tools me-1 text-primary"></i>@resume.SkillCount Skills</span>
                                    <span><i class="bi bi-briefcase me-1 text-primary"></i>@resume.ExperienceCount Experience</span>
                                </div>
                            </div>

                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a asp-area="Student" asp-controller="Resumes" asp-action="Builder" asp-route-resumeId="@resume.Id" 
                                   class="btn btn-sm @(resume.IsFinalized ? "btn-outline-secondary" : "btn-primary") flex-grow-1">
                                    <i class="bi @(resume.IsFinalized ? "bi-pencil" : "bi-arrow-right-circle") me-1"></i>
                                    @(resume.IsFinalized ? "Edit Details" : "Continue Editing")
                                </a>

                                @if (resume.IsFinalized)
                                {
                                    <a asp-area="Student" asp-controller="Resumes" asp-action="Download" asp-route-id="@resume.Id" 
                                       class="btn btn-sm btn-outline-primary" title="Download PDF">
                                        <i class="bi bi-download"></i>
                                    </a>
                                }

                                <a asp-area="Student" asp-controller="Resumes" asp-action="Analyze" asp-route-id="@resume.Id"
                                   class="btn btn-sm btn-outline-primary" title="ATS review">
                                    <i class="bi bi-clipboard-data"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 p-4">
            <partial name="_EmptyState" model='new EmptyStateViewModel("bi-file-earmark-person", "No resumes created yet", "Build your customized resume with our interactive step-by-step wizard to apply for internships.", "Start Building Resume", Url.Action("Builder", "Resumes", new { area = "Student" }))' />
        </div>
    }
</div>
