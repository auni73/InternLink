@model InternLink.Web.ViewModels.MockInterviewSessionViewModel
@{
    ViewData["Title"] = "Mock Interview";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill mb-2">
                <i class="bi bi-record-circle me-1"></i>Interview in progress
            </span>
            <h2 class="fw-bold mb-0 text-slate-800">@Model.Role</h2>
        </div>
        <a asp-action="Mock" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i><span>Back to Interview Prep</span>
        </a>
    </div>

    @await Html.PartialAsync("_MockChatShell", Model)
</div>

@section Scripts {
    <script type="module">
        import '/js/chat.js';
    </script>
}
