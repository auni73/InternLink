@model InternLink.Web.ViewModels.MockInterviewLaunchViewModel
@{
    ViewData["Title"] = "Mock Interview";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2">
            <i class="bi bi-mortarboard me-1"></i>Interview Prep
        </span>
        <h2 class="fw-bold mb-1 text-slate-800">Mock Interview</h2>
        <p class="text-secondary mb-0">One question at a time, with follow-ups that build on what you say.</p>
    </div>

    @await Html.PartialAsync("_PrepTabs")

    <div id="mockSetup" class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label for="mockRole" class="form-label fw-semibold">Role</label>
                    <input id="mockRole" type="text" class="form-control" maxlength="100"
                           placeholder="e.g. Backend .NET Intern" value="@Model.DefaultRole" />
                </div>
                <div class="col-lg-5">
                    <label for="mockJob" class="form-label fw-semibold">
                        Target posting <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <select id="mockJob" class="form-select">
                        <option value="">General interview for this role</option>
                        @foreach (var job in Model.TargetJobs)
                        {
                            <option value="@job.JobId">@job.Title — @job.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 d-grid">
                    <button id="startInterviewBtn" type="button"
                            class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-play-circle"></i><span>Start Interview</span>
                    </button>
                </div>
            </div>
            <div id="startError" class="alert alert-warning mt-3 mb-0 d-none" role="alert"></div>
        </div>
    </div>

    @await Html.PartialAsync("_MockChatShell", new InternLink.Web.ViewModels.MockInterviewSessionViewModel())

    @if (Model.RecentSessions.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-3 mt-4" id="recentSessions">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold text-slate-800">Your recent interviews</h6>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var session in Model.RecentSessions)
                {
                    var completed = session.Status == InternLink.Web.Models.Enums.MockInterviewStatus.Completed;
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                        <div>
                            <div class="fw-semibold text-slate-800">@session.Role</div>
                            <div class="small text-secondary">
                                @session.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm") · @session.TurnCount turns
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (completed)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-3">Completed</span>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Report" asp-route-sessionId="@session.Id">View report</a>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3">In progress</span>
                                <a class="btn btn-sm btn-primary"
                                   asp-action="Session" asp-route-sessionId="@session.Id">Resume</a>
                            }
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script type="module">
        import '/js/chat.js';
    </script>
}
