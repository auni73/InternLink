@model InternLink.Web.ViewModels.StudentAssessmentsViewModel
@{
    ViewData["Title"] = "Skill Assessments";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-slate-800 mb-1">Skill Assessments</h2>
            <p class="text-muted mb-0">Take timed 10-minute assessments to earn verified skill badges for your profile.</p>
        </div>
        <div class="text-end">
            <span class="badge bg-primary px-3 py-2 fs-6">
                <i class="bi bi-patch-check-fill me-1"></i>
                @Model.TotalVerifiedCount / @Model.TotalSkillsCount Skills Verified
            </span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Progress Overview Card -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md-8">
                    <h5 class="fw-bold text-slate-800 mb-1">Earn Verified Badges</h5>
                    <p class="text-muted small mb-3">
                        Score <strong>70% or higher</strong> on 5 multiple-choice questions in 10 minutes to verify your competency. 
                        Verified badges are derived directly from your assessment results and displayed to employers on your profile.
                    </p>
                    <div class="progress" style="height: 10px;">
                        @{
                            var progressPercent = Model.TotalSkillsCount > 0 
                                ? (int)Math.Round((double)Model.TotalVerifiedCount / Model.TotalSkillsCount * 100) 
                                : 0;
                        }
                        <div class="progress-bar bg-success" role="progressbar" 
                             style="width: @progressPercent%;" 
                             aria-valuenow="@progressPercent" 
                             aria-valuemin="0" 
                             aria-valuemax="100"></div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <div class="display-6 fw-bold text-success">@progressPercent%</div>
                    <div class="text-muted small fw-medium">Verification Progress</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Department Filter Tabs -->
    @{
        var myDeptCode = InternLink.Web.Models.EngineeringDepartments.GetDepartmentCode(Model.StudentDepartment);
    }
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <span class="small fw-bold text-muted text-uppercase tracking-wider">Filter by Discipline:</span>
                <div class="btn-group btn-group-sm flex-wrap" role="group" id="deptFilterGroup">
                    <button type="button" class="btn btn-outline-primary active" data-filter-dept="all">
                        All Skills (@Model.Skills.Count)
                    </button>
                    @if (!string.IsNullOrEmpty(myDeptCode) && myDeptCode != "GEN")
                    {
                        var myDeptCount = Model.Skills.Count(s => s.DepartmentCode == myDeptCode || s.DepartmentCode == "GEN");
                        <button type="button" class="btn btn-outline-primary" data-filter-dept="@myDeptCode">
                            <i class="bi bi-star-fill text-warning me-1"></i>My Department (@myDeptCode)
                        </button>
                    }
                    <button type="button" class="btn btn-outline-primary" data-filter-dept="CE">Civil (CE)</button>
                    <button type="button" class="btn btn-outline-primary" data-filter-dept="EEE">EEE</button>
                    <button type="button" class="btn btn-outline-primary" data-filter-dept="ME">Mechanical (ME)</button>
                    <button type="button" class="btn btn-outline-primary" data-filter-dept="IPE">IPE</button>
                    <button type="button" class="btn btn-outline-primary" data-filter-dept="TE">Textile (TE)</button>
                    <button type="button" class="btn btn-outline-primary" data-filter-dept="CSE">CSE</button>
                    <button type="button" class="btn btn-outline-primary" data-filter-dept="GEN">General Engineering</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Skills List Grouped by Domain -->
    @if (Model.Skills != null && Model.Skills.Count > 0)
    {
        var groupedSkills = Model.Skills.GroupBy(s => s.DomainName).OrderBy(g => g.Key);

        @foreach (var group in groupedSkills)
        {
            <div class="mb-4 skill-domain-group">
                <h5 class="fw-bold text-slate-700 mb-3 border-bottom pb-2">
                    <i class="bi bi-tag-fill text-primary me-2"></i>@group.Key
                </h5>

                <div class="row g-3">
                    @foreach (var skill in group)
                    {
                        <div class="col-md-6 col-lg-4 skill-card-wrapper" data-dept="@skill.DepartmentCode">
                            <div class="card h-100 shadow-sm border rounded-3 transition-hover d-flex flex-column">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <h5 class="fw-bold text-slate-800 mb-1">@skill.SkillName</h5>
                                            <div class="d-flex gap-1 flex-wrap">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">@skill.DepartmentCode</span>
                                                <span class="badge bg-light text-muted border small">@skill.DomainName</span>
                                            </div>
                                        </div>
                                        <div>
                                            @if (skill.IsVerified)
                                            {
                                                <partial name="_VerifiedSkillBadge" model="@skill.SkillName" />
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Unverified</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="my-auto py-2 text-muted small">
                                        @if (skill.BestScore.HasValue)
                                        {
                                            <div class="d-flex justify-content-between mb-1">
                                                <span>Best Score:</span>
                                                <strong class="@(skill.BestScore.Value >= 70 ? "text-success" : "text-slate-700")">
                                                    @skill.BestScore.Value%
                                                </strong>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span>Attempts:</span>
                                                <span>@skill.AttemptsCount</span>
                                            </div>
                                            @if (skill.LastAttemptDate.HasValue)
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span>Last Attempt:</span>
                                                    <span>@skill.LastAttemptDate.Value.ToString("MMM dd, yyyy")</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-muted fst-italic">No attempts recorded yet.</div>
                                        }
                                    </div>

                                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                        <span class="small text-muted">
                                            <i class="bi bi-clock me-1"></i>5 MCQs • 10m
                                        </span>
                                        <a asp-area="Student" asp-controller="Assessments" asp-action="Take" asp-route-skillId="@skill.SkillId" 
                                           class="btn btn-sm @(skill.IsVerified ? "btn-outline-primary" : "btn-primary") px-3">
                                            @(skill.IsVerified ? "Retake Exam" : "Take Assessment")
                                            <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterBtns = document.querySelectorAll('#deptFilterGroup button');
            const cards = document.querySelectorAll('.skill-card-wrapper');
            const domainGroups = document.querySelectorAll('.skill-domain-group');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const dept = this.getAttribute('data-filter-dept');

                    cards.forEach(card => {
                        const cardDept = card.getAttribute('data-dept');
                        if (dept === 'all' || cardDept === dept || (dept !== 'GEN' && cardDept === 'GEN')) {
                            card.style.display = '';
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    // Hide empty domain groups
                    domainGroups.forEach(group => {
                        const visibleCards = group.querySelectorAll('.skill-card-wrapper:not([style*="display: none"])');
                        group.style.display = visibleCards.length > 0 ? '' : 'none';
                    });
                });
            });
        });
    </script>
}
