@model InternLink.Web.ViewModels.StudentApplicationsViewModel
@using InternLink.Web.Helpers
@using InternLink.Web.Models.Enums
@{
    ViewData["Title"] = "My Applications";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-slate-800 mb-1">My Applications</h2>
            <p class="text-muted mb-0">Track your internship applications and interview stages in real time.</p>
        </div>
        <div>
            <a asp-area="Student" asp-controller="Jobs" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-search me-1"></i>Browse More Jobs
            </a>
        </div>
    </div>

    @if (Model.Applications != null && Model.Applications.Count > 0)
    {
        <div class="row g-4">
            @foreach (var app in Model.Applications)
            {
                <div class="col-12">
                    <div class="card shadow-sm border rounded-3 transition-hover">
                        <div class="card-body p-4">
                            <div class="row align-items-center g-3">
                                <!-- Job & Company Info -->
                                <div class="col-lg-4 col-md-12">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge @app.Status.GetBadgeClass() px-2 py-1">
                                            @app.Status.GetDisplayName()
                                        </span>
                                        <span class="badge bg-light text-muted border">
                                            <i class="bi bi-geo-alt me-1"></i>@app.LocationType
                                        </span>
                                    </div>
                                    <h5 class="fw-bold text-slate-800 mb-1">
                                        <a asp-area="Student" asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobId" class="text-decoration-none text-slate-800 hover-primary">
                                            @app.JobTitle
                                        </a>
                                    </h5>
                                    <div class="text-muted small fw-medium">
                                        <i class="bi bi-building me-1"></i>@app.CompanyName
                                    </div>
                                    <div class="text-muted small mt-2">
                                        <i class="bi bi-clock me-1"></i>Applied on @app.SubmittedAt.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                </div>

                                <!-- Horizontal Funnel Stepper -->
                                <div class="col-lg-5 col-md-12">
                                    <div class="px-2">
                                        <partial name="_ApplicationFunnel" model="@app.Status" />
                                    </div>
                                </div>

                                <!-- Actions & Quick Info -->
                                <div class="col-lg-3 col-md-12 text-lg-end">
                                    <div class="d-flex flex-column gap-2 align-items-lg-end">
                                        @if (app.AttachedResumeId.HasValue)
                                        {
                                            <a asp-area="Student" asp-controller="Resumes" asp-action="Download" asp-route-id="@app.AttachedResumeId.Value" 
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-file-earmark-pdf me-1"></i>Attached Resume
                                            </a>
                                        }

                                        <a asp-area="Student" asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobId" 
                                           class="btn btn-sm btn-outline-primary">
                                            View Job Posting <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Interview Callout if Scheduled -->
                            @if (app.Status == ApplicationStatus.Scheduled && app.InterviewDateTime.HasValue)
                            {
                                <div class="mt-3 p-3 bg-warning-subtle border border-warning-subtle rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                                    <div>
                                        <span class="fw-bold text-warning-emphasis"><i class="bi bi-calendar-event me-2"></i>Interview Scheduled</span>
                                        <div class="small text-muted mt-1">
                                            <strong>Date & Time:</strong> @app.InterviewDateTime.Value.ToString("dddd, MMMM dd, yyyy 'at' hh:mm tt")
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(app.MeetingLink))
                                    {
                                        <a href="@app.MeetingLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-warning fw-semibold">
                                            <i class="bi bi-camera-video me-1"></i>Join Interview Meeting
                                        </a>
                                    }
                                </div>
                            }

                            <!-- Cover Letter Snippet if present -->
                            @if (!string.IsNullOrWhiteSpace(app.CoverLetterText))
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <a class="small text-muted text-decoration-none" data-bs-toggle="collapse" href="#coverLetter_@app.ApplicationId" role="button" aria-expanded="false">
                                        <i class="bi bi-envelope-paper me-1"></i>View Submitted Cover Note <i class="bi bi-chevron-down small"></i>
                                    </a>
                                    <div class="collapse mt-2" id="coverLetter_@app.ApplicationId">
                                        <div class="card card-body bg-light-subtle small text-muted border-0">
                                            @app.CoverLetterText
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3 p-4">
            <partial name="_EmptyState" model='new EmptyStateViewModel("bi-file-earmark-text", "No applications submitted yet", "Explore active internship opportunities and submit your application with customized resumes.", "Browse Internships", Url.Action("Index", "Jobs", new { area = "Student" }))' />
        </div>
    }
</div>
