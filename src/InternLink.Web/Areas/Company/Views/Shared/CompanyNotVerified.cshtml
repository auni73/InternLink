@model InternLink.Web.Models.Company
@using InternLink.Web.Models.Enums
@{
    ViewData["Title"] = "Verification Required";
    var isPending = Model?.VerificationStatus == VerificationStatus.Pending;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <!-- Amber / Warning Header -->
                <div class="p-4 @(isPending ? "bg-warning-subtle text-warning-emphasis border-bottom border-warning-subtle" : "bg-danger-subtle text-danger border-bottom border-danger-subtle") d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle @(isPending ? "bg-warning text-dark" : "bg-danger text-white") d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi @(isPending ? "bi-shield-exclamation" : "bi-shield-x") fs-3"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">
                            @(isPending ? "Company Verification Under Review" : "Company Verification Declined")
                        </h4>
                        <p class="mb-0 small opacity-75">
                            Intentional platform access restriction &bull; Status Code: 403 Forbidden
                        </p>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h5 class="fw-semibold text-slate-800 mb-2">
                            @(isPending 
                                ? "Publishing and modifying job postings is currently locked." 
                                : "Your company verification was not approved by administration.")
                        </h5>
                        <p class="text-muted">
                            To ensure high-quality internship placements and verified career opportunities for students, all employer accounts must be verified by university administrators before job creation or modifications can occur.
                        </p>
                    </div>

                    <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small">Organization Name</div>
                                <div class="fw-bold text-slate-800">@(Model?.CompanyName ?? "Your Organization")</div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small">Current Status</div>
                                @if (isPending)
                                {
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill">
                                        <i class="bi bi-clock-history me-1"></i> Pending Admin Approval
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-1 rounded-pill">
                                        <i class="bi bi-x-circle me-1"></i> Rejected
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info d-flex align-items-start gap-2 border-0 bg-info-subtle text-info-emphasis rounded-3 p-3 mb-4 small">
                        <i class="bi bi-info-circle-fill mt-0 fs-6"></i>
                        <div>
                            <strong>What happens next?</strong> Once a platform administrator approves your company profile, you will immediately have full privileges to create vacancies, assign skill requirements, and track applicant talent pipelines.
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-center gap-3 pt-2">
                        <a asp-area="Company" asp-controller="Profile" asp-action="Index" class="btn btn-outline-primary px-4">
                            <i class="bi bi-building me-1"></i>Review Organization Profile
                        </a>
                        <a asp-area="Company" asp-controller="Jobs" asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-eye me-1"></i>View Job Postings (Read-Only)
                        </a>
                        <a asp-area="Company" asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                            <i class="bi bi-speedometer2 me-1"></i>Return to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
