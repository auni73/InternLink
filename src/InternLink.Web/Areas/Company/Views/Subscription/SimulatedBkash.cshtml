@{
    ViewData["Title"] = "bKash Payment Gateway";
    Layout = null; // Standalone authentic bKash checkout UI
    var paymentId = ViewBag.PaymentId as string;
    var amount = ViewBag.Amount as decimal? ?? 0m;
    var invoiceNumber = ViewBag.InvoiceNumber as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>bKash Payment - InternLink</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #f1f2f6;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .bkash-header {
            background-color: #D12053;
            color: #ffffff;
            border-top-left-radius: 12px;
            border-top-right-radius: 12px;
            padding: 24px;
        }
        .bkash-logo-badge {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: inline-block;
        }
        .bkash-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(209, 32, 83, 0.15);
            max-width: 440px;
            margin: 40px auto;
            background: #ffffff;
        }
        .btn-bkash {
            background-color: #D12053;
            color: #ffffff;
            font-weight: 600;
            border: none;
            padding: 12px;
            border-radius: 6px;
            transition: background-color 0.2s;
        }
        .btn-bkash:hover {
            background-color: #b01a45;
            color: #ffffff;
        }
        .sandbox-hint {
            background-color: #fff8e1;
            border-left: 4px solid #ffb300;
            padding: 10px 14px;
            font-size: 13px;
            border-radius: 4px;
            color: #5d4037;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="bkash-card">
            <!-- Header -->
            <div class="bkash-header text-center">
                <div class="bkash-logo-badge mb-1">bKash</div>
                <div class="small opacity-75">Merchant Checkout &bull; Developer Sandbox</div>
                <div class="mt-3 pt-2 border-top border-white border-opacity-25">
                    <div class="small opacity-75">Merchant: InternLink University Portal</div>
                    <div class="display-6 fw-bold mt-1">৳@amount.ToString("N2")</div>
                    <div class="small opacity-75">Invoice: @invoiceNumber</div>
                </div>
            </div>

            <!-- Body -->
            <div class="p-4">
                <div class="sandbox-hint mb-3">
                    <i class="bi bi-info-circle-fill me-1 text-warning"></i>
                    <strong>bKash Sandbox Test Credentials:</strong><br />
                    • Test Account: <code>01770618575</code><br />
                    • Test OTP: <code>123456</code> &bull; Test PIN: <code>12121</code>
                </div>

                <form asp-action="ExecuteSimulatedBkash" method="post" id="bkashForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentId" value="@paymentId" />

                    <!-- Step 1: Wallet Number -->
                    <div class="mb-3" id="stepWallet">
                        <label class="form-label small fw-semibold text-secondary">Your bKash Account Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">+88</span>
                            <input type="text" name="walletNumber" id="walletInput" class="form-control" value="01770618575" placeholder="e.g. 017xxxxxxxx" required maxlength="11" />
                        </div>
                    </div>

                    <!-- Step 2: Verification Code -->
                    <div class="mb-3" id="stepOtp">
                        <label class="form-label small fw-semibold text-secondary">bKash Verification Code (OTP)</label>
                        <input type="text" name="otp" id="otpInput" class="form-control font-monospace" value="123456" placeholder="Enter 6-digit OTP" required maxlength="6" />
                        <div class="form-text small">Sandbox OTP is auto-filled to <code>123456</code>.</div>
                    </div>

                    <!-- Step 3: PIN -->
                    <div class="mb-4" id="stepPin">
                        <label class="form-label small fw-semibold text-secondary">bKash PIN</label>
                        <input type="password" name="pin" id="pinInput" class="form-control font-monospace" value="12121" placeholder="Enter 5-digit PIN" required maxlength="5" />
                        <div class="form-text small">Sandbox test PIN is <code>12121</code>.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-bkash shadow-sm" id="confirmBtn">
                            <i class="bi bi-shield-lock-fill me-1"></i>Confirm & Pay ৳@amount.ToString("N2")
                        </button>
                        <a href="/Company/Subscription" class="btn btn-light text-secondary border btn-sm">
                            Cancel & Return
                        </a>
                    </div>
                </form>
            </div>

            <!-- Footer -->
            <div class="text-center pb-3 small text-muted">
                <i class="bi bi-lock-fill text-success me-1"></i>128-bit SSL Encrypted &bull; 24/7 Support: 16247
            </div>
        </div>
    </div>
</body>
</html>
