@using System.Security.Claims
@model CompanyDashboardViewModel
@{
    ViewData["Title"] = "Company Dashboard";
    var displayName = User.Identity?.Name;
    var role = User.FindFirstValue(ClaimTypes.Role);
}

<div class="mb-4">
    <h1 class="h3 mb-1">Welcome, @displayName</h1>
    <p class="text-muted mb-0">Signed in as <strong>@role</strong>. Your hiring pipeline at a glance.</p>
</div>

@if (Model.VerificationStatus == 0)
{
    <div class="alert alert-warning border-0 shadow-sm rounded-4 p-3 d-flex align-items-center gap-3 mb-4" role="alert">
        <i class="bi bi-hourglass-split fs-3 text-warning-emphasis"></i>
        <div>
            <div class="fw-bold text-warning-emphasis">Organization Verification Pending Review</div>
            <div class="small text-muted">Your company registration is currently pending administrative review. Job postings will become visible to candidates once approved.</div>
        </div>
    </div>
}
else if (Model.VerificationStatus == 2)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-4 p-3 mb-4" role="alert">
        <div class="d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
            <span class="fw-bold text-danger">Organization Verification Rejected</span>
        </div>
        <div class="small text-slate-700 mb-2">
            Your organization profile was not approved during administrative verification.
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.AdminRejectionReason))
        {
            <div class="p-2 bg-white rounded border border-danger-subtle small text-danger">
                <strong>Feedback / Reason:</strong> @Model.AdminRejectionReason
            </div>
        }
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <partial name="_StatCard" view-data='new ViewDataDictionary(ViewData) { { "Icon", "bi-briefcase" }, { "Label", "Open job postings" }, { "Value", Model.OpenJobsCount } }' />
    </div>
    <div class="col-sm-6 col-lg-4">
        <partial name="_StatCard" view-data='new ViewDataDictionary(ViewData) { { "Icon", "bi-people" }, { "Label", "Total applicants" }, { "Value", Model.TotalApplicantsCount } }' />
    </div>
</div>
