@using System.Security.Claims
@model CounselorDashboardViewModel
@{
    ViewData["Title"] = "Counselor Dashboard";
    var displayName = User.Identity?.Name;
    var role = User.FindFirstValue(ClaimTypes.Role);
}

<div class="mb-4">
    <h1 class="h3 mb-1">Welcome, @displayName</h1>
    <p class="text-muted mb-0">Signed in as <strong>@role</strong>.</p>
</div>

<div class="row g-3">
    <div class="col-sm-6 col-lg-4">
        <partial name="_StatCard" view-data='new ViewDataDictionary(ViewData) { { "Icon", "bi-person-lines-fill" }, { "Label", "Students on InternLink" }, { "Value", Model.StudentCount }, { "Url", "/Counselor/Students" } }' />
    </div>
</div>

<div class="mt-4">
    <a class="btn btn-primary" href="/Counselor/Students"><i class="bi bi-person-lines-fill bi-dense me-1"></i>Open student directory</a>
</div>
