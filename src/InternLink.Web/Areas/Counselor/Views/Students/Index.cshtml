@model InternLink.Web.ViewModels.CounselorStudentDirectoryViewModel
@{
    ViewData["Title"] = "Student Advising Directory";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                    <i class="bi bi-person-video3 me-1"></i>Career Counseling
                </span>
                <span class="text-muted small">|</span>
                <span class="text-muted small fw-medium">@Model.TotalCount Students Registered</span>
            </div>
            <h2 class="fw-bold mb-0 text-slate-800">Student Advising Directory</h2>
        </div>

        <!-- Search Bar -->
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm shadow-sm" style="min-width: 320px;">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" 
                       placeholder="Search by name, ID, department, email..." value="@Model.Search" />
                <button class="btn btn-primary px-3" type="submit">Search</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Clear search">
                    <i class="bi bi-x-circle"></i>
                </a>
            }
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Students Directory Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-slate-800">
                <i class="bi bi-mortarboard-fill text-primary me-2"></i>Students Directory
            </h5>
            <span class="text-muted small">Total: @Model.TotalCount students</span>
        </div>

        <div class="card-body p-0">
            @if (Model.Students != null && Model.Students.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Student Name</th>
                                <th>Student ID</th>
                                <th>Department</th>
                                <th>CGPA</th>
                                <th class="text-center">Resumes</th>
                                <th class="text-center">Applications</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-slate-800">@student.FullName</div>
                                        <div class="text-muted small">
                                            <i class="bi bi-envelope me-1"></i>@student.Email
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">@student.InstitutionalId</span>
                                    </td>
                                    <td>
                                        <span class="text-slate-700">@student.Department</span>
                                    </td>
                                    <td>
                                        <span class="badge @(student.CGPA >= 3.5m ? "bg-success-subtle text-success border border-success-subtle" : student.CGPA >= 3.0m ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-warning-subtle text-warning border border-warning-subtle") px-2 py-1 rounded-pill">
                                            @student.CGPA.ToString("0.00")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-2 py-1">
                                            <i class="bi bi-file-earmark-person me-1"></i>@student.ResumeCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2 py-1">
                                            <i class="bi bi-send me-1"></i>@student.ApplicationCount
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@student.StudentId" class="btn btn-sm btn-primary rounded-pill px-3">
                                            <i class="bi bi-folder2-open me-1"></i>Advising File
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount total students)
                        </div>
                        <nav aria-label="Student directory pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" 
                                       asp-route-search="@Model.Search">Previous</a>
                                </li>
                                @for (var p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@p" 
                                           asp-route-search="@Model.Search">@p</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" 
                                       asp-route-search="@Model.Search">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-mortarboard text-muted display-4"></i>
                    <h5 class="fw-semibold text-slate-700 mt-3 mb-1">No Students Found</h5>
                    <p class="text-muted small mb-0">No student profiles match your search criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
