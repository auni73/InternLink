@model InternLink.Web.ViewModels.CounselorStudentDetailViewModel
@{
    ViewData["Title"] = $"Advising File: {Model.Student.FirstName} {Model.Student.LastName}";
}

<div class="container-fluid py-4">
    <!-- Breadcrumb & Header -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Student Directory</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Student.FirstName @Model.Student.LastName</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="fw-bold mb-0 text-slate-800">
                    @Model.Student.FirstName @Model.Student.LastName
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 align-middle ms-2">
                        @Model.Student.InstitutionalId
                    </span>
                </h2>
                <div class="text-muted small mt-1">
                    <span class="me-3"><i class="bi bi-mortarboard me-1"></i>@Model.Student.Department</span>
                    <span class="me-3"><i class="bi bi-envelope me-1"></i>@Model.UserEmail</span>
                    <span><i class="bi bi-star-fill text-warning me-1"></i>CGPA: <strong>@Model.Student.CGPA.ToString("0.00")</strong></span>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i>Back to Directory
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabbed Navigation Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2 gap-2" id="counselorTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "profile" ? "active fw-bold text-primary" : "text-muted")" 
                            id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-pane" type="button" role="tab">
                        <i class="bi bi-person-badge me-1"></i>Profile & Skills
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "resumes" ? "active fw-bold text-primary" : "text-muted")" 
                            id="resumes-tab" data-bs-toggle="tab" data-bs-target="#resumes-pane" type="button" role="tab">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Resumes
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill ms-1">@Model.Resumes.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "applications" ? "active fw-bold text-primary" : "text-muted")" 
                            id="applications-tab" data-bs-toggle="tab" data-bs-target="#applications-pane" type="button" role="tab">
                        <i class="bi bi-send-check me-1"></i>Applications
                        <span class="badge bg-info-subtle text-info-emphasis rounded-pill ms-1">@Model.Applications.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(Model.ActiveTab == "notes" ? "active fw-bold text-primary" : "text-muted")" 
                            id="notes-tab" data-bs-toggle="tab" data-bs-target="#notes-pane" type="button" role="tab">
                        <i class="bi bi-journal-text me-1"></i>Advising Notes
                        <span class="badge bg-primary rounded-pill ms-1">@Model.Feedbacks.Count</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <div class="tab-content" id="counselorTabContent">
                
                <!-- TAB 1: Profile & Skills -->
                <div class="tab-pane fade @(Model.ActiveTab == "profile" ? "show active" : "")" id="profile-pane" role="tabpanel">
                    <div class="row g-4">
                        <div class="col-lg-7">
                            <h5 class="fw-bold text-slate-800 mb-3">
                                <i class="bi bi-person-lines-fill text-primary me-2"></i>Personal Biography
                            </h5>
                            @if (!string.IsNullOrWhiteSpace(Model.Student.Biography))
                            {
                                <p class="text-slate-700 bg-light p-3 rounded-3 border mb-4">@Model.Student.Biography</p>
                            }
                            else
                            {
                                <div class="alert alert-light border text-muted small mb-4">No biography provided by the student.</div>
                            }

                            <h5 class="fw-bold text-slate-800 mb-3">
                                <i class="bi bi-compass text-primary me-2"></i>Career Interests & Goals
                            </h5>
                            @if (!string.IsNullOrWhiteSpace(Model.Student.Interests))
                            {
                                <p class="text-slate-700 bg-light p-3 rounded-3 border">@Model.Student.Interests</p>
                            }
                            else
                            {
                                <div class="alert alert-light border text-muted small">No career interests specified yet.</div>
                            }
                        </div>

                        <div class="col-lg-5">
                            <h5 class="fw-bold text-slate-800 mb-3">
                                <i class="bi bi-tools text-primary me-2"></i>Verified / Declared Skills
                            </h5>
                            @if (Model.Skills != null && Model.Skills.Count > 0)
                            {
                                <div class="list-group shadow-sm rounded-3">
                                    @foreach (var skill in Model.Skills)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="fw-bold text-slate-800">@(skill.Skill?.SkillName ?? "Skill")</div>
                                                <div class="text-muted small">Proficiency: Level @skill.ProficiencyLevel of 5</div>
                                            </div>
                                            <div class="text-end">
                                                @for (var star = 1; star <= 5; star++)
                                                {
                                                    <i class="bi @(star <= skill.ProficiencyLevel ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border text-muted small">No skills added to this student's profile.</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- TAB 2: Resumes -->
                <div class="tab-pane fade @(Model.ActiveTab == "resumes" ? "show active" : "")" id="resumes-pane" role="tabpanel">
                    <h5 class="fw-bold text-slate-800 mb-3">
                        <i class="bi bi-file-earmark-text text-primary me-2"></i>Student Resumes
                    </h5>
                    @if (Model.Resumes != null && Model.Resumes.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light text-muted small">
                                    <tr>
                                        <th>Resume ID</th>
                                        <th>Last Modified</th>
                                        <th>Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var resume in Model.Resumes)
                                    {
                                        <tr>
                                            <td class="font-monospace text-slate-700">@resume.Id</td>
                                            <td>@resume.LastModified.ToString("MMM dd, yyyy hh:mm tt")</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(resume.DocumentPath))
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                                        <i class="bi bi-check2-circle me-1"></i>Finalized PDF
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-2 py-1">
                                                        Draft In Progress
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-area="Student" asp-controller="Resume" asp-action="Preview" asp-route-id="@resume.Id" 
                                                   target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                    <i class="bi bi-eye me-1"></i>View PDF
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border text-muted small">No resumes generated or uploaded by this student.</div>
                    }
                </div>

                <!-- TAB 3: Applications -->
                <div class="tab-pane fade @(Model.ActiveTab == "applications" ? "show active" : "")" id="applications-pane" role="tabpanel">
                    <h5 class="fw-bold text-slate-800 mb-3">
                        <i class="bi bi-send-check-fill text-primary me-2"></i>Internship Applications History
                    </h5>
                    @if (Model.Applications != null && Model.Applications.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light text-muted small">
                                    <tr>
                                        <th>Job Title</th>
                                        <th>Company</th>
                                        <th>Submitted Date</th>
                                        <th>Status</th>
                                        <th>Interview Info</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.Applications)
                                    {
                                        <tr>
                                            <td class="fw-bold text-slate-800">@app.JobTitle</td>
                                            <td>@app.CompanyName</td>
                                            <td>@app.SubmittedAt.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                                    @app.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (app.InterviewDateTime.HasValue)
                                                {
                                                    <div class="small">
                                                        <strong>@app.InterviewDateTime.Value.ToString("MMM dd, yyyy hh:mm tt")</strong>
                                                        @if (!string.IsNullOrWhiteSpace(app.MeetingLink))
                                                        {
                                                            <div><a href="@app.MeetingLink" target="_blank" class="text-decoration-none small text-truncate d-inline-block" style="max-width: 200px;">@app.MeetingLink</a></div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small italic">None scheduled</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border text-muted small">No internship applications submitted by this student yet.</div>
                    }
                </div>

                <!-- TAB 4: Advising Notes -->
                <div class="tab-pane fade @(Model.ActiveTab == "notes" ? "show active" : "")" id="notes-pane" role="tabpanel">
                    
                    <!-- New Advising Note Form -->
                    <div class="card border-0 bg-light rounded-4 p-4 mb-4 shadow-sm">
                        <h5 class="fw-bold text-slate-800 mb-3">
                            <i class="bi bi-pencil-square text-primary me-2"></i>Log New Advising Feedback Note
                        </h5>
                        <form asp-action="Feedback" asp-route-id="@Model.Student.Id" method="post">
                            @Html.AntiForgeryToken()
                            @* Use explicit name= (not asp-for) so the POST binds to CounselorFeedbackCreateViewModel
                               directly, not the nested NewFeedback.XXX path from the parent model *@
                            <input type="hidden" name="StudentId" value="@Model.Student.Id" />

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label for="meetingDateInput" class="form-label fw-semibold text-slate-700">Meeting Date</label>
                                    <input id="meetingDateInput" name="MeetingDate" type="date" class="form-control bg-white" 
                                           value="@Model.NewFeedback.MeetingDate.ToString("yyyy-MM-dd")" required />
                                    <span class="text-muted small">Counselors may log past or scheduled advising meetings.</span>
                                </div>

                                <div class="col-md-8 text-end d-flex align-items-end justify-content-end">
                                    <span id="markdownCharCount" class="small text-muted fw-semibold">0 / 5,000</span>
                                </div>

                                <div class="col-lg-6">
                                    <label for="narrativeMarkdownInput" class="form-label fw-semibold text-slate-700">
                                        Feedback Notes (Markdown Enabled)
                                    </label>
                                    <textarea id="narrativeMarkdownInput" name="NarrativeMarkdown"
                                              rows="8" class="form-control bg-white font-monospace" 
                                              placeholder="Write advising notes, recommendations, resume action items, or interview preparation tips in Markdown... (e.g. ## Action Items&#10;- Polish ASP.NET Core project&#10;- Practice mock interview questions)"
                                              maxlength="5000" required></textarea>
                                </div>

                                <div class="col-lg-6">
                                    <label class="form-label fw-semibold text-slate-700">Live Sanitized Preview</label>
                                    <div id="markdownPreviewContainer" class="p-3 bg-white border rounded-3 overflow-auto" style="min-height: 200px; max-height: 240px;">
                                        <em class="text-muted">Live preview will appear here as you type...</em>
                                    </div>
                                    <span class="text-muted small">Note: Raw HTML &amp; scripts are automatically escaped for security.</span>
                                </div>

                                <div class="col-12 text-end">
                                    <button type="submit" class="btn btn-primary px-4 rounded-pill shadow-sm">
                                        <i class="bi bi-save me-1"></i>Save Advising Note
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Advising Notes History -->
                    <h5 class="fw-bold text-slate-800 mb-3">
                        <i class="bi bi-clock-history text-primary me-2"></i>Advising History (@Model.Feedbacks.Count Notes)
                    </h5>

                    @if (Model.Feedbacks != null && Model.Feedbacks.Count > 0)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var feedback in Model.Feedbacks)
                            {
                                <div class="card border rounded-3 shadow-sm">
                                    <div class="card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="fw-bold text-slate-800"><i class="bi bi-person-check-fill text-primary me-1"></i>@feedback.CounselorName</span>
                                            <span class="text-muted small">(@feedback.CounselorEmail)</span>
                                        </div>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-calendar3 me-1"></i>Meeting: @feedback.MeetingDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </div>
                                    <div class="card-body p-3">
                                        <partial name="_MarkdownContent" model="feedback.NarrativeMarkdown" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-3 border">
                            <i class="bi bi-journal-x text-muted display-6"></i>
                            <p class="text-muted small mb-0 mt-2">No advising feedback notes logged for this student yet.</p>
                        </div>
                    }

                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/counselor-advising.js"></script>
}
