@model InternLink.Web.ViewModels.AdminUserListViewModel
@{
    ViewData["Title"] = "User Moderation";
    var activeRole = Model.RoleFilter ?? "All";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                    <i class="bi bi-shield-lock me-1"></i>Platform Administration
                </span>
                <span class="text-muted small">|</span>
                <span class="text-muted small fw-medium">@Model.TotalCount Accounts Found</span>
            </div>
            <h2 class="fw-bold mb-0 text-slate-800">User Moderation & Account Management</h2>
        </div>

        <!-- Search Bar -->
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <input type="hidden" name="role" value="@Model.RoleFilter" />
            <div class="input-group input-group-sm shadow-sm" style="min-width: 280px;">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" 
                       placeholder="Search by name, email, company..." value="@Model.SearchQuery" />
                <button class="btn btn-primary px-3" type="submit">Search</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-action="Index" asp-route-role="@Model.RoleFilter" class="btn btn-sm btn-outline-secondary" title="Clear search">
                    <i class="bi bi-x-circle"></i>
                </a>
            }
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Role Filter Tabs -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2 gap-2">
                <li class="nav-item">
                    <a class="nav-link @(string.IsNullOrEmpty(Model.RoleFilter) || Model.RoleFilter == "All" ? "active fw-bold" : "text-muted")" 
                       asp-action="Index" asp-route-role="" asp-route-search="@Model.SearchQuery">
                        <i class="bi bi-people me-1"></i>All Users
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill ms-1">@Model.TotalAllCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.RoleFilter == "Students" ? "active fw-bold text-primary" : "text-muted")" 
                       asp-action="Index" asp-route-role="Students" asp-route-search="@Model.SearchQuery">
                        <i class="bi bi-mortarboard me-1"></i>Students
                        <span class="badge bg-primary-subtle text-primary rounded-pill ms-1">@Model.TotalStudentsCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.RoleFilter == "Companies" ? "active fw-bold text-primary" : "text-muted")" 
                       asp-action="Index" asp-route-role="Companies" asp-route-search="@Model.SearchQuery">
                        <i class="bi bi-building me-1"></i>Companies
                        <span class="badge bg-info-subtle text-info rounded-pill ms-1">@Model.TotalCompaniesCount</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Users Table -->
        <div class="card-body p-0">
            @if (Model.Users != null && Model.Users.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">User / Display Name</th>
                                <th>Role</th>
                                <th>Profile Details</th>
                                <th>Status</th>
                                <th>Registered</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-slate-800">@user.DisplayName</div>
                                        <div class="text-muted small">
                                            <i class="bi bi-envelope me-1"></i>@user.Email
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(user.Role == "Admin" ? "bg-dark" : user.Role == "Company" ? "bg-info-subtle text-info border border-info-subtle" : user.Role == "Student" ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-light text-dark") px-3 py-1 rounded-pill">
                                            @user.Role
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(user.DetailSummary))
                                        {
                                            <span class="small text-slate-700">@user.DetailSummary</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">No profile linked</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-slash-circle me-1"></i>Suspended
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small text-slate-700">@user.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">@user.CreatedAt.ToString("hh:mm tt")</div>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (user.Role != "Admin")
                                        {
                                            @if (user.IsActive)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger trigger-suspend-user-btn"
                                                        data-bs-toggle="modal" data-bs-target="#suspendUserModal"
                                                        data-user-id="@user.UserId" data-user-email="@user.Email" data-user-name="@user.DisplayName">
                                                    <i class="bi bi-slash-circle me-1"></i>Suspend
                                                </button>
                                            }
                                            else
                                            {
                                                <form asp-action="Reactivate" asp-route-id="@user.UserId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-check-circle me-1"></i>Reactivate
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Protected</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Showing page <strong>@Model.Page</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount total records)
                        </div>
                        <nav aria-label="Users pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" 
                                       asp-route-role="@Model.RoleFilter" asp-route-search="@Model.SearchQuery">Previous</a>
                                </li>
                                @for (var p = 1; p <= Model.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.Page ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-page="@p" 
                                           asp-route-role="@Model.RoleFilter" asp-route-search="@Model.SearchQuery">@p</a>
                                    </li>
                                }
                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" 
                                       asp-route-role="@Model.RoleFilter" asp-route-search="@Model.SearchQuery">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people text-slate-300 display-4"></i>
                    <h5 class="fw-semibold text-slate-700 mt-3 mb-1">No Users Found</h5>
                    <p class="text-muted small mb-0">Try modifying your search criteria or role filters.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Suspend Confirmation Modal -->
<div class="modal fade" id="suspendUserModal" tabindex="-1" aria-labelledby="suspendUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-danger" id="suspendUserModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Suspend User Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3 text-slate-700">
                    Are you sure you want to suspend <strong id="suspendUserName">this user</strong> (<span id="suspendUserEmail" class="text-muted"></span>)?
                </p>
                <div class="alert alert-warning border-0 bg-warning-subtle text-warning-emphasis small rounded-3 mb-0">
                    <i class="bi bi-shield-slash me-1"></i>
                    <strong>Security Enforcement:</strong> Suspending this user immediately blocks all new sign-in attempts. The user's Identity security stamp will be invalidated, terminating any active browser sessions within ~5 minutes.
                </div>
            </div>
            <div class="modal-footer border-top p-3">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                <form id="suspendUserConfirmForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-slash-circle me-1"></i>Confirm Suspension
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const suspendModal = document.getElementById('suspendUserModal');
            const suspendForm = document.getElementById('suspendUserConfirmForm');
            const suspendNameEl = document.getElementById('suspendUserName');
            const suspendEmailEl = document.getElementById('suspendUserEmail');

            document.querySelectorAll('.trigger-suspend-user-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const userId = btn.getAttribute('data-user-id');
                    const email = btn.getAttribute('data-user-email');
                    const name = btn.getAttribute('data-user-name');

                    if (suspendForm) suspendForm.action = `/Admin/Users/${userId}/Suspend`;
                    if (suspendNameEl) suspendNameEl.textContent = name;
                    if (suspendEmailEl) suspendEmailEl.textContent = email;
                });
            });
        });
    </script>
}
