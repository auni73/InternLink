@model InternLink.Web.ViewModels.AdminCompanyQueueViewModel
@using InternLink.Web.Models.Enums
@{
    ViewData["Title"] = "Company Approvals";
    var currentStatus = Model.StatusFilter;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                    <i class="bi bi-building-check me-1"></i>Moderation Queue
                </span>
                <span class="text-muted small">|</span>
                <span class="text-muted small fw-medium" id="companyQueueCountHeader">@Model.Companies.Count Organizations</span>
            </div>
            <h2 class="fw-bold mb-0 text-slate-800">Employer & Company Verification Queue</h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Status Filter Tabs -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2 gap-2">
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == VerificationStatus.Pending ? "active fw-bold text-warning-emphasis" : "text-muted")" 
                       asp-action="Index" asp-route-status="Pending">
                        <i class="bi bi-hourglass-split me-1"></i>Pending Review
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill ms-1" id="pendingCompanyBadge">@Model.PendingCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == VerificationStatus.Verified ? "active fw-bold text-success" : "text-muted")" 
                       asp-action="Index" asp-route-status="Verified">
                        <i class="bi bi-check-circle me-1"></i>Verified Employers
                        <span class="badge bg-success-subtle text-success rounded-pill ms-1">@Model.VerifiedCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == VerificationStatus.Rejected ? "active fw-bold text-danger" : "text-muted")" 
                       asp-action="Index" asp-route-status="Rejected">
                        <i class="bi bi-x-circle me-1"></i>Rejected
                        <span class="badge bg-danger-subtle text-danger rounded-pill ms-1">@Model.RejectedCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(!currentStatus.HasValue ? "active fw-bold text-slate-800" : "text-muted")" 
                       asp-action="Index" asp-route-status="">
                        <i class="bi bi-list-ul me-1"></i>All Records
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill ms-1">@Model.TotalCount</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Companies Table -->
        <div class="card-body p-0">
            @if (Model.Companies != null && Model.Companies.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Company Name</th>
                                <th>Industry Sector</th>
                                <th>Website</th>
                                <th>Status</th>
                                <th>Registered</th>
                                <th class="text-end pe-4">Verification Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in Model.Companies)
                            {
                                <tr id="company-row-@company.CompanyId">
                                    <td class="ps-4">
                                        <div class="fw-bold text-slate-800">@company.CompanyName</div>
                                        <div class="text-muted small">
                                            <i class="bi bi-envelope me-1"></i>@company.Email
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-slate-700 border">
                                            @company.IndustrySector
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(company.CorporateWebsite))
                                        {
                                            <a href="@company.CorporateWebsite" target="_blank" rel="noopener noreferrer" class="small fw-medium text-primary text-decoration-none">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>@company.CorporateWebsite
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small italic">Not provided</span>
                                        }
                                    </td>
                                    <td>
                                        @if (company.VerificationStatus == VerificationStatus.Verified)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                                <i class="bi bi-patch-check-fill me-1"></i>Verified
                                            </span>
                                        }
                                        else if (company.VerificationStatus == VerificationStatus.Rejected)
                                        {
                                            <div>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill mb-1">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Rejected
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(company.AdminRejectionReason))
                                                {
                                                    <div class="text-danger small mt-1" style="font-size: 0.75rem; max-width: 250px;">
                                                        <strong>Reason:</strong> @company.AdminRejectionReason
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Pending Review
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small text-slate-700">@company.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            @if (company.VerificationStatus != VerificationStatus.Verified)
                                            {
                                                <form asp-action="Approve" asp-route-id="@company.CompanyId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success approve-company-btn" data-company-id="@company.CompanyId" title="Approve & Verify Organization">
                                                        <i class="bi bi-check-circle me-1"></i>Approve
                                                    </button>
                                                </form>
                                            }
                                            @if (company.VerificationStatus != VerificationStatus.Rejected)
                                            {
                                                <button type="button" class="btn btn-outline-danger trigger-reject-company-btn"
                                                        data-bs-toggle="modal" data-bs-target="#rejectCompanyModal"
                                                        data-company-id="@company.CompanyId" data-company-name="@company.CompanyName"
                                                        title="Reject Organization Verification">
                                                    <i class="bi bi-x-circle me-1"></i>Reject
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-building-check text-slate-300 display-4"></i>
                    <h5 class="fw-semibold text-slate-700 mt-3 mb-1">Queue Empty</h5>
                    <p class="text-muted small mb-0">No organizations currently matching this verification status.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reject Company Modal -->
<div class="modal fade" id="rejectCompanyModal" tabindex="-1" aria-labelledby="rejectCompanyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold text-danger" id="rejectCompanyModalLabel">
                    <i class="bi bi-x-circle-fill me-2"></i>Reject Company Verification
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="rejectCompanyConfirmForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="mb-3 text-slate-700">
                        Rejecting verification for <strong id="rejectCompanyName">this company</strong>.
                    </p>

                    <div class="mb-3">
                        <label for="rejectionReasonInput" class="form-label fw-semibold small text-slate-700">
                            Rejection Reason (Visible to Company)
                        </label>
                        <textarea name="reason" id="rejectionReasonInput" class="form-control" rows="3" 
                                  maxlength="500" placeholder="e.g. Unverifiable corporate domain or incomplete business documentation."></textarea>
                        <div class="form-text small text-muted">This feedback will be displayed directly on the company's portal banner.</div>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-x-circle me-1"></i>Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const rejectModal = document.getElementById('rejectCompanyModal');
            const rejectForm = document.getElementById('rejectCompanyConfirmForm');
            const rejectNameEl = document.getElementById('rejectCompanyName');

            document.querySelectorAll('.trigger-reject-company-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const companyId = btn.getAttribute('data-company-id');
                    const companyName = btn.getAttribute('data-company-name');

                    if (rejectForm) rejectForm.action = `/Admin/Companies/${companyId}/Reject`;
                    if (rejectNameEl) rejectNameEl.textContent = companyName;
                });
            });
        });
    </script>
}
