@model InternLink.Web.ViewModels.AdminAnalyticsViewModel
@{
    ViewData["Title"] = "Executive Analytics";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                    <i class="bi bi-graph-up me-1"></i>Platform Intelligence
                </span>
                <span class="text-muted small">|</span>
                <span class="text-muted small fw-medium">Live Snapshot</span>
            </div>
            <h2 class="fw-bold mb-0 text-slate-800">Executive Analytics Cockpit</h2>
        </div>

        <div>
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2 shadow-sm rounded-3" onclick="window.location.reload()">
                <i class="bi bi-arrow-clockwise"></i>Refresh Data
            </button>
        </div>
    </div>

    <!-- Top Row: 4 Primary KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- 1. Active Students -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Active Students</div>
                        <h2 class="fw-bold text-slate-800 my-2">@Model.ActiveStudentCount</h2>
                        <div class="small text-muted">
                            <i class="bi bi-check-circle text-success me-1"></i>Enrolled & active
                        </div>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary rounded-4 p-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-mortarboard fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Verified Employers -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Verified Employers</div>
                        <h2 class="fw-bold text-slate-800 my-2">@Model.ActiveCompanyCount</h2>
                        <div class="small text-muted">
                            <i class="bi bi-patch-check text-info me-1"></i>Approved hiring partners
                        </div>
                    </div>
                    <div class="stat-icon bg-info-subtle text-info rounded-4 p-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-building-check fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Open Job Vacancies -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Live Job Vacancies</div>
                        <h2 class="fw-bold text-slate-800 my-2">@Model.OpenJobCount</h2>
                        <div class="small text-muted">
                            <i class="bi bi-broadcast text-success me-1"></i>Active student postings
                        </div>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success rounded-4 p-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-briefcase fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Total Applications -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Applications</div>
                        <h2 class="fw-bold text-slate-800 my-2">@Model.TotalApplicationsCount</h2>
                        <div class="small text-muted">
                            <i class="bi bi-send text-primary me-1"></i>Candidate submissions
                        </div>
                    </div>
                    <div class="stat-icon bg-warning-subtle text-warning-emphasis rounded-4 p-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-file-earmark-person fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Row: 2 Highlight KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-calendar2-check fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-slate-800 mb-0">@Model.TotalInterviewsCount Interviews Scheduled</h5>
                        <div class="small text-muted">Employer-student candidate interview sessions organized</div>
                    </div>
                </div>
                <span class="badge bg-primary text-white rounded-pill px-3 py-2">Active Pipeline</span>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-patch-check-fill fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-slate-800 mb-0">@Model.VerifiedSkillsEarnedCount Verified Skill Badges</h5>
                        <div class="small text-muted">Technical assessments passed with scores &ge; 70%</div>
                    </div>
                </div>
                <span class="badge bg-success text-white rounded-pill px-3 py-2">Validated Competency</span>
            </div>
        </div>
    </div>

    <!-- Visualizations Row: Line Chart + Doughnut Chart -->
    <div class="row g-4 mb-4">
        <!-- 7-Day Application Submission Velocity Line Chart -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-slate-800 mb-0">Application Velocity (Last 7 Days)</h5>
                        <div class="small text-muted">Continuous daily application submission volume</div>
                    </div>
                    <span class="badge bg-light text-slate-700 border">7-Day Continuous CTE</span>
                </div>
                <div class="card-body p-4">
                    <div style="height: 300px; position: relative;">
                        <canvas id="dailyTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Application Pipeline Status Breakdown Doughnut Chart -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-slate-800 mb-0">Pipeline Stage Distribution</h5>
                        <div class="small text-muted">Current status of all submitted applications</div>
                    </div>
                    <span class="badge bg-light text-slate-700 border">@Model.TotalApplicationsCount Total</span>
                </div>
                <div class="card-body p-4 d-flex align-items-center justify-content-center">
                    <div style="height: 280px; width: 100%; position: relative;">
                        <canvas id="statusBreakdownChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Embedded Data Island (Zero Fetch Round-Trip) -->
<script id="analyticsData" type="application/json">
@Html.Raw(Model.JsonPayload)
</script>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
