@model InternLink.Web.ViewModels.AdminJobQueueViewModel
@using InternLink.Web.Models.Enums
@{
    ViewData["Title"] = "Job Approvals";
    var currentFilter = Model.ApprovedFilter;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                    <i class="bi bi-clipboard-check me-1"></i>Moderation Queue
                </span>
                <span class="text-muted small">|</span>
                <span class="text-muted small fw-medium" id="jobQueueCountHeader">@Model.Jobs.Count Postings</span>
            </div>
            <h2 class="fw-bold mb-0 text-slate-800">Job Vacancy & Internship Moderation Queue</h2>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" id="btnSyncExternal" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-cloud-arrow-down"></i>
                <span id="syncBtnText">Sync External Jobs</span>
            </button>
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAddExternalJob">
                <i class="bi bi-plus-circle"></i>
                <span>Add External Job</span>
            </button>
            <form asp-action="ReindexAll" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Rebuild Semantic Index</span>
                </button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Tabs -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2 gap-2">
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == false ? "active fw-bold text-warning-emphasis" : "text-muted")" 
                       asp-action="Index" asp-route-approved="false">
                        <i class="bi bi-hourglass-split me-1"></i>Pending Approval
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill ms-1" id="pendingJobBadge">@Model.PendingCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == true ? "active fw-bold text-success" : "text-muted")" 
                       asp-action="Index" asp-route-approved="true">
                        <i class="bi bi-check-circle me-1"></i>Approved & Published
                        <span class="badge bg-success-subtle text-success rounded-pill ms-1">@Model.ApprovedCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(!currentFilter.HasValue ? "active fw-bold text-slate-800" : "text-muted")" 
                       asp-action="Index" asp-route-approved="">
                        <i class="bi bi-list-ul me-1"></i>All Active Vacancies
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill ms-1">@Model.TotalCount</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Jobs List -->
        <div class="card-body p-0">
            @if (Model.Jobs != null && Model.Jobs.Count > 0)
            {
                <div class="list-group list-group-flush rounded-bottom-4">
                    @foreach (var job in Model.Jobs)
                    {
                        <div class="list-group-item p-4 border-bottom job-approval-item" id="job-item-@job.JobId">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h5 class="fw-bold text-slate-800 mb-0">@job.Title</h5>
                                        @if (job.Source == JobSource.Internal)
                                        {
                                            <span class="badge bg-teal-subtle text-teal border border-teal-subtle">
                                                <i class="bi bi-shield-check me-1"></i>Direct
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-purple-subtle text-purple border border-purple-subtle">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>@(job.ExternalSourceName ?? "External")
                                            </span>
                                        }
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi @(job.LocationType == LocationType.Remote ? "bi-laptop" : job.LocationType == LocationType.Hybrid ? "bi-building-gear" : "bi-geo-alt") me-1"></i>
                                            @job.LocationType
                                        </span>
                                        @if (job.IsApproved)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Live & Visible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Pending Review
                                            </span>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-building me-1"></i>
                                        <strong class="text-slate-700">@job.CompanyName</strong>
                                        @if (!string.IsNullOrWhiteSpace(job.CorporateWebsite))
                                        {
                                            <span class="mx-1">•</span>
                                            <a href="@job.CorporateWebsite" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>@job.CorporateWebsite
                                            </a>
                                        }
                                        <span class="mx-1">•</span>
                                        <span>Deadline: @job.DeadLine.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>

                                <div>
                                    @if (!job.IsApproved)
                                    {
                                        <form asp-action="Approve" asp-route-id="@job.JobId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success px-4 d-inline-flex align-items-center gap-2 shadow-sm approve-job-btn" data-job-id="@job.JobId">
                                                <i class="bi bi-check-circle-fill"></i>Approve & Publish
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-success small fw-semibold">
                                            <i class="bi bi-check-all fs-5 align-middle"></i>Published
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Truncated / Expandable Core Description -->
                            <div class="mt-3">
                                <div class="p-3 bg-light rounded-3 text-slate-700 small border job-description-container" id="desc-@job.JobId">
                                    <div class="job-description-short">
                                        @(job.CoreDescription.Length > 220 ? job.CoreDescription.Substring(0, 220) + "..." : job.CoreDescription)
                                    </div>
                                    @if (job.CoreDescription.Length > 220 || !string.IsNullOrWhiteSpace(job.SelectionCriteria))
                                    {
                                        <div class="job-description-full d-none mt-2 pt-2 border-top">
                                            <h6 class="fw-bold text-slate-800 small mb-1">Full Description:</h6>
                                            <div style="white-space: pre-wrap;" class="mb-2">@job.CoreDescription</div>

                                            @if (!string.IsNullOrWhiteSpace(job.SelectionCriteria))
                                            {
                                                <h6 class="fw-bold text-slate-800 small mb-1">Selection Criteria:</h6>
                                                <div style="white-space: pre-wrap;">@job.SelectionCriteria</div>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-primary text-decoration-none toggle-desc-btn" 
                                                data-target="desc-@job.JobId">
                                            <i class="bi bi-chevron-down me-1"></i>Expand Full Details
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard-check text-slate-300 display-4"></i>
                    <h5 class="fw-semibold text-slate-700 mt-3 mb-1">No Jobs In Queue</h5>
                    <p class="text-muted small mb-0">All submitted vacancies have been reviewed and processed.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal: Add External Job (AI Smart-Paste & Manual Form) -->
<div class="modal fade" id="modalAddExternalJob" tabindex="-1" aria-labelledby="modalAddExternalJobLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <h5 class="modal-title fw-bold text-slate-800 mb-0" id="modalAddExternalJobLabel">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Add External Opportunity
                    </h5>
                    <p class="text-muted small mb-0">Ingest job circulars from newspapers, LinkedIn, or external portals.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs border-bottom px-4 pt-2 gap-2" id="externalJobModalTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-smart-paste-link" data-bs-toggle="tab" data-bs-target="#tab-smart-paste" type="button" role="tab">
                            <i class="bi bi-magic text-primary me-1"></i>AI Smart-Paste
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-review-link" data-bs-toggle="tab" data-bs-target="#tab-review" type="button" role="tab">
                            <i class="bi bi-pencil-square text-success me-1"></i>Review & Publish Form
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-4">
                    <!-- Tab 1: AI Smart-Paste -->
                    <div class="tab-pane fade show active" id="tab-smart-paste" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-slate-800 mb-0">Raw Circular / Flyer Text</label>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnInsertSampleCircular">
                                <i class="bi bi-lightning-charge me-1"></i>Try Sample Circular
                            </button>
                        </div>
                        <textarea class="form-control font-monospace small mb-3" id="rawCircularText" rows="10" placeholder="Paste unstructured job circular, flyer contents, or LinkedIn post here..."></textarea>
                        
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" id="btnExtractCircular">
                                <span class="spinner-border spinner-border-sm d-none" id="extractSpinner" role="status" aria-hidden="true"></span>
                                <i class="bi bi-cpu"></i>
                                <span>Extract with Gemini AI</span>
                            </button>
                        </div>
                    </div>

                    <!-- Tab 2: Review & Publish Form -->
                    <div class="tab-pane fade" id="tab-review" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label small fw-bold">Job Title *</label>
                                <input type="text" class="form-control" id="extJobTitle" placeholder="e.g. Trainee Software Engineer" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Company Name Snapshot *</label>
                                <input type="text" class="form-control" id="extCompanyName" placeholder="e.g. Brain Station 23" required />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label small fw-bold">Source Portal / Circular *</label>
                                <input type="text" class="form-control" id="extSourceName" value="Manual / Circular" required />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small fw-bold">External Application URL *</label>
                                <input type="url" class="form-control" id="extApplyUrl" placeholder="https://..." required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Location Arrangement *</label>
                                <select class="form-select" id="extLocationType">
                                    <option value="0">Remote</option>
                                    <option value="1" selected>On-Site</option>
                                    <option value="2">Hybrid</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Application Deadline</label>
                                <input type="date" class="form-control" id="extDeadline" />
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold">Role Description & Responsibilities *</label>
                                <textarea class="form-control" id="extCoreDesc" rows="4" placeholder="Summary of role duties..." required></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold">Selection Criteria & Prerequisites</label>
                                <textarea class="form-control" id="extCriteria" rows="3" placeholder="Educational degree, CGPA, or prerequisites..."></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label small fw-bold">Targeted Skills (Comma Separated)</label>
                                <input type="text" class="form-control" id="extSkillTags" placeholder="e.g. C#, ASP.NET Core, SQL Server, React, Docker" />
                                <div class="form-text small">Skills matching the platform's catalog will be auto-linked to drive AI student recommendations.</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-success d-inline-flex align-items-center gap-2" id="btnSubmitExternalJob">
                                <i class="bi bi-check-circle"></i>
                                <span>Publish External Job</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin-moderation.js" asp-append-version="true"></script>
    <script type="module" src="~/js/admin-external-jobs.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.toggle-desc-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-target');
                    const container = document.getElementById(targetId);
                    if (!container) return;

                    const full = container.querySelector('.job-description-full');
                    const short = container.querySelector('.job-description-short');

                    if (full.classList.contains('d-none')) {
                        full.classList.remove('d-none');
                        short.classList.add('d-none');
                        btn.innerHTML = '<i class="bi bi-chevron-up me-1"></i>Collapse Details';
                    } else {
                        full.classList.add('d-none');
                        short.classList.remove('d-none');
                        btn.innerHTML = '<i class="bi bi-chevron-down me-1"></i>Expand Full Details';
                    }
                });
            });
        });
    </script>
}
