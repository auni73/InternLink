@model InternLink.Web.ViewModels.AdminJobQueueViewModel
@using InternLink.Web.Models.Enums
@{
    ViewData["Title"] = "Job Approvals";
    var currentFilter = Model.ApprovedFilter;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                    <i class="bi bi-clipboard-check me-1"></i>Moderation Queue
                </span>
                <span class="text-muted small">|</span>
                <span class="text-muted small fw-medium" id="jobQueueCountHeader">@Model.Jobs.Count Postings</span>
            </div>
            <h2 class="fw-bold mb-0 text-slate-800">Job Vacancy & Internship Moderation Queue</h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Tabs -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2 gap-2">
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == false ? "active fw-bold text-warning-emphasis" : "text-muted")" 
                       asp-action="Index" asp-route-approved="false">
                        <i class="bi bi-hourglass-split me-1"></i>Pending Approval
                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill ms-1" id="pendingJobBadge">@Model.PendingCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentFilter == true ? "active fw-bold text-success" : "text-muted")" 
                       asp-action="Index" asp-route-approved="true">
                        <i class="bi bi-check-circle me-1"></i>Approved & Published
                        <span class="badge bg-success-subtle text-success rounded-pill ms-1">@Model.ApprovedCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(!currentFilter.HasValue ? "active fw-bold text-slate-800" : "text-muted")" 
                       asp-action="Index" asp-route-approved="">
                        <i class="bi bi-list-ul me-1"></i>All Active Vacancies
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill ms-1">@Model.TotalCount</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Jobs List -->
        <div class="card-body p-0">
            @if (Model.Jobs != null && Model.Jobs.Count > 0)
            {
                <div class="list-group list-group-flush rounded-bottom-4">
                    @foreach (var job in Model.Jobs)
                    {
                        <div class="list-group-item p-4 border-bottom job-approval-item" id="job-item-@job.JobId">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h5 class="fw-bold text-slate-800 mb-0">@job.Title</h5>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi @(job.LocationType == LocationType.Remote ? "bi-laptop" : job.LocationType == LocationType.Hybrid ? "bi-building-gear" : "bi-geo-alt") me-1"></i>
                                            @job.LocationType
                                        </span>
                                        @if (job.IsApproved)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-check-circle-fill me-1"></i>Live & Visible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i>Pending Review
                                            </span>
                                        }
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-building me-1"></i>
                                        <strong class="text-slate-700">@job.CompanyName</strong>
                                        @if (!string.IsNullOrWhiteSpace(job.CorporateWebsite))
                                        {
                                            <span class="mx-1">•</span>
                                            <a href="@job.CorporateWebsite" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>@job.CorporateWebsite
                                            </a>
                                        }
                                        <span class="mx-1">•</span>
                                        <span>Deadline: @job.DeadLine.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>

                                <div>
                                    @if (!job.IsApproved)
                                    {
                                        <form asp-action="Approve" asp-route-id="@job.JobId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success px-4 d-inline-flex align-items-center gap-2 shadow-sm approve-job-btn" data-job-id="@job.JobId">
                                                <i class="bi bi-check-circle-fill"></i>Approve & Publish
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-success small fw-semibold">
                                            <i class="bi bi-check-all fs-5 align-middle"></i>Published
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Truncated / Expandable Core Description -->
                            <div class="mt-3">
                                <div class="p-3 bg-light rounded-3 text-slate-700 small border job-description-container" id="desc-@job.JobId">
                                    <div class="job-description-short">
                                        @(job.CoreDescription.Length > 220 ? job.CoreDescription.Substring(0, 220) + "..." : job.CoreDescription)
                                    </div>
                                    @if (job.CoreDescription.Length > 220 || !string.IsNullOrWhiteSpace(job.SelectionCriteria))
                                    {
                                        <div class="job-description-full d-none mt-2 pt-2 border-top">
                                            <h6 class="fw-bold text-slate-800 small mb-1">Full Description:</h6>
                                            <div style="white-space: pre-wrap;" class="mb-2">@job.CoreDescription</div>

                                            @if (!string.IsNullOrWhiteSpace(job.SelectionCriteria))
                                            {
                                                <h6 class="fw-bold text-slate-800 small mb-1">Selection Criteria:</h6>
                                                <div style="white-space: pre-wrap;">@job.SelectionCriteria</div>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-link btn-sm p-0 mt-1 text-primary text-decoration-none toggle-desc-btn" 
                                                data-target="desc-@job.JobId">
                                            <i class="bi bi-chevron-down me-1"></i>Expand Full Details
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard-check text-slate-300 display-4"></i>
                    <h5 class="fw-semibold text-slate-700 mt-3 mb-1">No Jobs In Queue</h5>
                    <p class="text-muted small mb-0">All submitted vacancies have been reviewed and processed.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/admin-moderation.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.toggle-desc-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-target');
                    const container = document.getElementById(targetId);
                    if (!container) return;

                    const full = container.querySelector('.job-description-full');
                    const short = container.querySelector('.job-description-short');

                    if (full.classList.contains('d-none')) {
                        full.classList.remove('d-none');
                        short.classList.add('d-none');
                        btn.innerHTML = '<i class="bi bi-chevron-up me-1"></i>Collapse Details';
                    } else {
                        full.classList.add('d-none');
                        short.classList.remove('d-none');
                        btn.innerHTML = '<i class="bi bi-chevron-down me-1"></i>Expand Full Details';
                    }
                });
            });
        });
    </script>
}
